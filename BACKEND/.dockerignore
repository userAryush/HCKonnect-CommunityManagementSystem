# Generated / local runtime data
media/
staticfiles/
*.log
*.sqlite3

# Docs and local tooling (not needed in image)
*.md
Dockerfile*
docker-compose*.yml
.dockerignore

# Tests (optional trim for smaller production images)
**/tests.py
**/test_*.py

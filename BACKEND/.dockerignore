# Virtual environments
env/
venv/
.venv/
ENV/

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Git and editor
.git/
.gitignore
.idea/
.vscode/
*.swp
*.swo

# Secrets (inject at runtime via --env-file or compose)
.env
